{
  "name": "vapefree",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --lan --clear",
    "start:local": "expo start",
    "android": "expo start --android --lan --clear",
    "ios": "expo start --ios --lan --clear",
    "web": "expo start --web",
    "dev": "node scripts/dev.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "maestro test .maestro/flows",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "build:apk:local": "eas build --platform android --profile preview --local",
    "postinstall": "patch-package",
    "emulators": "firebase emulators:start --import=./firebase-emulator-data --export-on-exit",
    "emulators:clear": "firebase emulators:start"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "0.2.3",
    "@expo-google-fonts/quicksand": "0.2.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "57.0.20",
    "expo-constants": "57.0.17",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.2",
    "expo-web-browser": "57.0.2",
    "firebase": "11.6.0",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "concurrently": "^10.0.5",
    "eslint": "9.22.0",
    "eslint-config-expo": "57.0.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-plugin-react-native-a11y": "3.5.1",
    "firebase-tools": "^13.34.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.0",
    "patch-package": "^8.0.1",
    "prettier": "3.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "wait-on": "^9.1.0",
    "eas-cli": "^16.0.0"
  }
}
