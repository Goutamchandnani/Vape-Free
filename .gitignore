# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (generated by prebuild; omit if you commit android/ and ios/)
android/
ios/
.kotlin/

# Environment & secrets
.env
.env.*
!.env.example
functions/.env

# Firebase (local emulators & logs)
firebase-emulator-data/
firebase-export-*/
*-debug.log
.firebaserc.local

# Cloud Functions build output (see also functions/.gitignore)
functions/lib/
functions/node_modules/

# Tests & coverage
coverage/

# Logs & OS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# EAS / credentials (never commit secrets)
google-services.json
GoogleService-Info.plist
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Misc tooling
.metro-health-check*
