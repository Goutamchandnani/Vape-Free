# Local development defaults: Firebase Emulator Suite (no billing required).
# Copy to .env: cp .env.example .env

EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_PROJECT_ID=vapefree-msc
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west2

# Use your computer LAN IP when testing on a physical phone (not localhost).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.10

# Production Firebase web app keys (Spark plan, no card required).
# Fill these in only when the Firebase Console project is fully active.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# EAS build profile identifiers (optional for local dev)
EAS_PROJECT_ID=
